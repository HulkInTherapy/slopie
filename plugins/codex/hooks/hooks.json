{
  "description": "slopie: keep the plain-text session records current, and on resume or after compaction say where this session's record is.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "timeout": 20,
            "command": "exec sh \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT:-.}}/hooks/session-start.sh\""
          }
        ]
      }
    ]
  }
}
