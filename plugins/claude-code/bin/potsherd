#!/bin/sh
# The slopie this plugin runs: the bundle vendored in the plugin, else a surrounding checkout's build,
# else `slopie` on PATH. A shim that silently runs nothing is worse than none, so the last branch says so.
set -u
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export POTSHERD_CLI_PUBLIC_NAME="${POTSHERD_CLI_PUBLIC_NAME:-slopie}"
if [ -f "$ROOT/dist/potsherd.js" ]; then exec node "$ROOT/dist/potsherd.js" "$@"; fi
if [ -f "$ROOT/../../packages/cli/dist/potsherd.js" ]; then exec node "$ROOT/../../packages/cli/dist/potsherd.js" "$@"; fi
if command -v slopie >/dev/null 2>&1; then exec slopie "$@"; fi
cat >&2 <<MSG
slopie: this plugin has no slopie to run, so nothing was done. Looked in:
  1. $ROOT/dist/potsherd.js                     (vendored in the plugin)
  2. $ROOT/../../packages/cli/dist/potsherd.js  (a surrounding checkout)
  3. slopie on PATH                             (npm i -g slopie)
MSG
exit 127
