{
  "name": "slopie",
  "version": "1.9.4",
  "description": "slopie — search your past coding-agent sessions. Plus `slopie audit`, a Wrapped of your year.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/HulkInTherapy/slopie",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HulkInTherapy/slopie.git"
  },
  "bugs": "https://github.com/HulkInTherapy/slopie/issues",
  "keywords": [
    "claude-code",
    "codex",
    "pi",
    "session",
    "history",
    "transcript",
    "memory",
    "search",
    "audit",
    "cli",
    "mcp"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "slopie": "bin/slopie.js",
    "potsherd": "bin/potsherd.js"
  },
  "files": [
    "bin",
    "dist/potsherd.js",
    "dist/potsherd.js.map",
    "dist/audit-native-worker.js",
    "dist/audit-native-worker.js.map",
    "dist/records-worker.js",
    "dist/records-worker.js.map",
    "README.md",
    "LICENSE",
    "NOTICE",
    "licenses"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "node ../../scripts/package-readme.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@potsherd/core": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "commander": "^12.1.0"
  }
}
